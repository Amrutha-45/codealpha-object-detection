# =========================================================
# Environment Configuration — AI Object Detection & Tracking
# Copy this file to ".env" and adjust values as needed.
# =========================================================

# --- App Info ---
APP_NAME=AI Object Detection & Tracking API
APP_VERSION=1.0.0
ENVIRONMENT=development          # development | production

# --- Server ---
HOST=0.0.0.0
PORT=8000
RELOAD=true                      # auto-reload on code changes (dev only)

# --- CORS ---
# Comma-separated list of allowed origins for the React frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- YOLO Model ---
# Swap freely between yolov8n.pt / yolov8s.pt / yolov8m.pt without code changes
MODEL_WEIGHTS_PATH=weights/yolov8n.pt
DEFAULT_CONFIDENCE=0.5
DEVICE=cpu                       # cpu | cuda | mps

# --- Tracking ---
TRACKER_TYPE=bytetrack           # bytetrack | deepsort
TRACKER_CONFIG_PATH=bytetrack.yaml

# --- Allowed Detection Classes (COCO class names, comma-separated) ---
ALLOWED_CLASSES=person,car,bicycle,bus,truck,dog,cat,bottle,chair,laptop

# --- Storage Paths ---
UPLOAD_DIR=storage/uploads
OUTPUT_DIR=storage/outputs
SCREENSHOT_DIR=storage/screenshots

# --- Upload Limits ---
MAX_UPLOAD_SIZE_MB=200
ALLOWED_VIDEO_EXTENSIONS=.mp4,.avi,.mov
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png

# --- Webcam Session ---
WEBCAM_SOURCE=0                  # default OS camera index

# --- Logging ---
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_FILE=logs/app.log
