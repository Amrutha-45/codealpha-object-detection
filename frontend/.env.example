# =========================================================
# Frontend Environment Configuration
# Copy this file to ".env" and adjust for your deployment.
# =========================================================

# Leave empty during local development — Vite's dev server proxies
# /detect, /stats, /download, /health to http://localhost:8000 (see vite.config.ts).
#
# In production, set this to your deployed FastAPI backend's origin, e.g.:
# VITE_API_BASE_URL=https://api.yourdomain.com
VITE_API_BASE_URL=
